# ========================================
# 爸爸妈妈讲故事 - 服务端环境变量配置
# ========================================
# 复制此文件为 .env 并修改配置
#   cp .env.example .env
# ========================================

# --- 服务端口 ---
# 对外暴露的端口（Nginx 反代时使用内网端口 9999）
PORT=9999

# --- JWT 认证 ---
# 生产环境务必修改为随机强密码！
JWT_SECRET=change-this-to-a-strong-random-secret
# Token 有效期，如 7d / 30d / 1h
JWT_EXPIRES_IN=7d

# --- 数据库 ---
# SQLite 数据库文件路径（容器内路径，无需修改）
DATABASE_URL=file:./data/prod.db

# --- 文件上传 ---
# 上传目录（容器内路径，无需修改）
UPLOAD_DIR=./uploads

# --- 管理员账号 ---
# 首次启动时自动创建，后续修改密码需通过管理后台
ADMIN_EMAIL=admin@mamababa.com
ADMIN_PASSWORD=change-this-admin-password

# --- 可选：Nginx 反代 ---
# 如果使用 Nginx 反代，设置信任代理
# TRUST_PROXY=true